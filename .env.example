DUCKDB_PATH=data/steam_market.duckdb
MIN_REVIEWS=50
STEAM_LANGUAGE=all
STEAM_REVIEWS_PER_PAGE=100
STEAM_INCLUDE_OFFTOPIC=true
STEAM_REQUESTS_PER_SECOND=1.0
STEAMSPY_ENABLED=true
STEAMSPY_REQUESTS_PER_SECOND=1.0
STEAMSPY_CATALOG_PAGES=1
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local
LLM_MODEL=Qwen3.6-35B-A3B
LLM_TEMPERATURE=0.1
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=180
LLM_CONCURRENCY=1
LLM_BATCH_SIZE=8
LLM_BATCH_MAX_CHARACTERS=12000
ENRICH_LANGUAGES=english
ENRICH_MIN_CHARACTERS=40
ENRICHMENT_VERSION=v2
GENRE_TAXONOMY_VERSION=v1
STEAMID_HASH_SALT=change-me-to-a-long-random-local-secret
HTTP_MAX_RETRIES=5
LLM_MAX_RETRIES=3
LOG_LEVEL=INFO
